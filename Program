import numpy as np
from PIL import Image
import matplotlib.pyplot as plt


# ============================================================
# 1. LOAD AND PREPROCESS MEDICAL IMAGE
# ============================================================

def load_medical_image(image_path):
    image = Image.open(image_path).convert("L")

    # Resize image to a manageable size
    image = image.resize((32, 32))

    # Convert image to NumPy array
    image_array = np.array(image, dtype=np.float32)

    # Normalize pixel values from 0-255 to 0-1
    image_array = image_array / 255.0

    return image_array


# ============================================================
# 2. CREATE FEATURE MATRIX
# ============================================================

def create_feature_matrix(image_array):
    """
    Convert 32x32 image into a feature matrix.

    1024 pixels are converted into a 1024 x 1 feature vector.
    """

    feature_vector = image_array.flatten()

    return feature_vector.reshape(1024, 1)


# ============================================================
# 3. MATRIX CHAIN MULTIPLICATION
# ============================================================

def matrix_chain_order(dimensions):

    n = len(dimensions) - 1

    # m[i][j] stores minimum multiplication cost
    m = np.zeros((n, n), dtype=np.int64)

    # s[i][j] stores optimal split
    s = np.zeros((n, n), dtype=np.int64)

    # Chain length
    for length in range(2, n + 1):

        for i in range(n - length + 1):

            j = i + length - 1

            # Initialize with infinity
            m[i][j] = float("inf")

            # Try every possible split
            for k in range(i, j):

                cost = (
                    m[i][k]
                    + m[k + 1][j]
                    + dimensions[i]
                    * dimensions[k + 1]
                    * dimensions[j + 1]
                )

                if cost < m[i][j]:

                    m[i][j] = cost
                    s[i][j] = k

    return m, s


# ============================================================
# 4. RECONSTRUCT OPTIMAL PARENTHESIZATION
# ============================================================

def optimal_parenthesization(s, i, j):

    if i == j:
        return f"A{i + 1}"

    k = s[i][j]

    left = optimal_parenthesization(s, i, k)
    right = optimal_parenthesization(s, k + 1, j)

    return f"({left} × {right})"


# ============================================================
# 5. DISPLAY DP TABLE
# ============================================================

def display_cost_table(m):

    print("\n========== DP COST TABLE ==========\n")

    n = len(m)

    print("       ", end="")

    for i in range(n):
        print(f"A{i + 1:>10}", end="")

    print()

    for i in range(n):

        print(f"A{i + 1:<5}", end="")

        for j in range(n):

            if j < i:
                print(f"{'-':>11}", end="")

            else:
                print(f"{m[i][j]:>11}", end="")

        print()


# ============================================================
# 6. PERFORM MATRIX OPERATIONS
# ============================================================

def multiply_chain(A1, A2, A3, A4, order):

    """
    Demonstration of the selected parenthesization.

    The actual numerical matrices are multiplied according
    to the optimal order found by MCM.
    """

    if order == "((A1 × A2) × A3) × A4":

        R1 = A1 @ A2
        R2 = R1 @ A3
        R3 = R2 @ A4

    elif order == "(A1 × A2) × (A3 × A4)":

        R1 = A1 @ A2
        R2 = A3 @ A4
        R3 = R1 @ R2

    else:

        # General recursive multiplication is more complex,
        # so this branch is only for demonstration.
        R1 = A1 @ A2
        R2 = R1 @ A3
        R3 = R2 @ A4

    return R3


# ============================================================
# 7. MAIN PROGRAM
# ============================================================

def main():

    print("=" * 60)
    print(" MEDICAL IMAGE OPTIMIZATION USING MATRIX CHAIN MULTIPLICATION")
    print("=" * 60)

    # --------------------------------------------------------
    # IMAGE INPUT
    # --------------------------------------------------------

    image_path = input("\nEnter medical image path: ")

    image = load_medical_image(image_path)

    print("\nImage successfully loaded.")
    print("Image size:", image.shape)

    # --------------------------------------------------------
    # CREATE FEATURE VECTOR
    # --------------------------------------------------------

    feature_matrix = create_feature_matrix(image)

    print("\nFeature matrix shape:")
    print(feature_matrix.shape)

    # --------------------------------------------------------
    # SIMULATED ML FEATURE PIPELINE
    # --------------------------------------------------------
    #
    # Feature matrix:
    # 1024 x 1
    #
    # Transpose converts it to:
    # 1 x 1024
    #
    # We use a simplified ML pipeline:
    #
    # A1 = 1 x 1024
    # A2 = 1024 x 128
    # A3 = 128 x 64
    # A4 = 64 x 10
    #
    # --------------------------------------------------------

    A1 = feature_matrix.T

    A2 = np.random.rand(1024, 128)

    A3 = np.random.rand(128, 64)

    A4 = np.random.rand(64, 10)

    matrices = [A1, A2, A3, A4]

    print("\nMatrix dimensions:")

    for i, matrix in enumerate(matrices):

        print(
            f"A{i + 1} = "
            f"{matrix.shape[0]} × {matrix.shape[1]}"
        )

    # --------------------------------------------------------
    # DIMENSION ARRAY
    # --------------------------------------------------------

    dimensions = [
        A1.shape[0],
        A1.shape[1],
        A2.shape[1],
        A3.shape[1],
        A4.shape[1]
    ]

    print("\nDimension array:")
    print(dimensions)

    # --------------------------------------------------------
    # RUN MATRIX CHAIN DP
    # --------------------------------------------------------

    m, s = matrix_chain_order(dimensions)

    # --------------------------------------------------------
    # DISPLAY DP TABLE
    # --------------------------------------------------------

    display_cost_table(m)

    # --------------------------------------------------------
    # OPTIMAL PARENTHESIZATION
    # --------------------------------------------------------

    order = optimal_parenthesization(
        s,
        0,
        len(m) - 1
    )

    print("\n========== OPTIMIZATION RESULT ==========\n")

    print("Minimum scalar multiplications:")
    print(m[0][len(m) - 1])

    print("\nOptimal parenthesization:")
    print(order)

    # --------------------------------------------------------
    # IMAGE OUTPUT
    # --------------------------------------------------------

    result = multiply_chain(
        A1,
        A2,
        A3,
        A4,
        order
    )

    print("\nFinal ML output matrix shape:")
    print(result.shape)

    # --------------------------------------------------------
    # DISPLAY IMAGE
    # --------------------------------------------------------

    plt.figure(figsize=(5, 5))

    plt.imshow(image, cmap="gray")

    plt.title(
        "Input Medical Image\n"
        "Preprocessed for ML Feature Extraction"
    )

    plt.axis("off")

    plt.show()

    print("\nProgram completed successfully.")
